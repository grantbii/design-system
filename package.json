{
  "name": "@grantbii/design-system",
  "version": "1.7.2",
  "description": "Grantbii's Design System",
  "homepage": "https://design.grantbii.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grantbii/design-system.git"
  },
  "license": "UNLICENSED",
  "main": "./index.js",
  "types": "./index.d.ts",
  "scripts": {
    "lint": "next lint",
    "prepare": "husky",
    "build": "npx tsc && cp -r ./core/assets ./dist/core && cp ./package.json ./dist && cp README.md ./dist",
    "postpublish": "rm -rf dist/",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@grantbii/ui-core": "1.3.0",
    "@phosphor-icons/react": "2.1.10",
    "country-flag-icons": "1.5.21",
    "next": "15.5.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-dropzone": "14.3.8",
    "react-spinners": "0.17.0",
    "styled-components": "6.1.19"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "4.1.1",
    "@eslint/js": "9.38.0",
    "@next/eslint-plugin-next": "15.5.6",
    "@storybook/addon-a11y": "9.1.13",
    "@storybook/addon-docs": "9.1.13",
    "@storybook/addon-onboarding": "9.1.13",
    "@storybook/addon-vitest": "9.1.13",
    "@storybook/nextjs-vite": "9.1.13",
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.38.0",
    "eslint-config-next": "15.5.6",
    "eslint-plugin-storybook": "9.1.13",
    "husky": "9.1.7",
    "lint-staged": "16.2.6",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "storybook": "9.1.13",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "lint-staged": {
    "**/*.{html,css,json,md,yaml}": [
      "prettier --write"
    ],
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
