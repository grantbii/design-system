{
  "name": "@grantbii/design-system",
  "author": "Grantbii",
  "license": "UNLICENSED",
  "version": "1.9.7",
  "description": "Grantbii's Design System",
  "homepage": "https://design.grantbii.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grantbii/design-system.git"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "scripts": {
    "lint": "next lint",
    "prepare": "husky",
    "build": "npx tsc && cp -r ./core/assets ./dist/core && cp ./package.json ./dist && cp README.md ./dist",
    "postpublish": "rm -rf dist/",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@grantbii/ui-core": "1.5.3",
    "@phosphor-icons/react": "2.1.10",
    "country-flag-icons": "1.6.4",
    "next": "16.0.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "14.3.8",
    "react-spinners": "0.17.0",
    "styled-components": "6.1.19"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "4.1.3",
    "@eslint/js": "9.39.2",
    "@next/eslint-plugin-next": "16.0.10",
    "@storybook/addon-a11y": "10.1.8",
    "@storybook/addon-docs": "10.1.8",
    "@storybook/addon-onboarding": "10.1.8",
    "@storybook/addon-vitest": "10.1.8",
    "@storybook/nextjs-vite": "10.1.8",
    "@types/node": "22.18.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitest/browser": "4.0.15",
    "@vitest/browser-playwright": "4.0.15",
    "@vitest/coverage-v8": "4.0.15",
    "eslint": "9.39.2",
    "eslint-config-next": "16.0.10",
    "eslint-plugin-storybook": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "playwright": "1.57.0",
    "prettier": "3.7.4",
    "storybook": "10.1.8",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  },
  "lint-staged": {
    "**/*.{html,css,json,md,yaml}": [
      "prettier --write"
    ],
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
